# TruthCert Environment Configuration
# Copy this file to .env and fill in values

# =============================================================================
# REQUIRED - Signing Keys
# =============================================================================

# Ed25519 private key (base64 encoded)
# Generate with: tc keygen --output keys
TRUTHCERT_SIGNING_KEY=

# Ed25519 public key (base64 encoded)
# Optional - will be derived from private key if not set
TRUTHCERT_PUBLIC_KEY=

# =============================================================================
# Server Configuration
# =============================================================================

# Server bind address
TRUTHCERT_HOST=0.0.0.0

# Server port
TRUTHCERT_PORT=8000

# =============================================================================
# Storage Configuration
# =============================================================================

# Bundle storage directory
TRUTHCERT_BUNDLE_DIR=./bundles

# Evidence cache directory
TRUTHCERT_EVIDENCE_CACHE=./evidence_cache

# Memory database path
TRUTHCERT_MEMORY_DB=./memory.db

# Log directory
TRUTHCERT_LOG_DIR=./logs/spans

# =============================================================================
# Request Limits
# =============================================================================

# Maximum claims per certification request
TRUTHCERT_MAX_CLAIMS=10000

# Maximum request body size in MB
TRUTHCERT_MAX_REQUEST_MB=50

# =============================================================================
# Rate Limiting
# =============================================================================

# Rate limit for /certify endpoint
TRUTHCERT_RATE_LIMIT_CERTIFY=10/minute

# Rate limit for /verify endpoint
TRUTHCERT_RATE_LIMIT_VERIFY=60/minute

# Default rate limit for other endpoints
TRUTHCERT_RATE_LIMIT_DEFAULT=100/minute

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
TRUTHCERT_LOG_LEVEL=INFO

# =============================================================================
# Optional - Model Provider (for future integration)
# =============================================================================

# Z.AI API key (optional)
# ZAI_API_KEY=

# =============================================================================
# Optional - Remote Memory Backend (disabled by default)
# =============================================================================

# Remote memory endpoint (disabled by default)
# TRUTHCERT_MEMORY_REMOTE_URL=

# =============================================================================
# DO NOT COMMIT REAL VALUES
# This file is a template only
# =============================================================================
