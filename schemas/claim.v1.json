{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truthcert.io/schemas/claim.v1.json",
  "title": "NumericClaim",
  "description": "A numeric claim requiring certification",
  "type": "object",
  "required": ["claim_id", "claim_type", "value", "evidence"],
  "properties": {
    "claim_id": {
      "type": "string",
      "description": "Unique identifier for this claim",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": ["effect_size", "heterogeneity", "sample_size", "p_value", "confidence_interval", "count", "proportion", "custom"],
      "description": "Type of numeric claim"
    },
    "value": {
      "type": "number",
      "description": "The numeric value being claimed"
    },
    "unit": {
      "type": ["string", "null"],
      "description": "Unit of measurement"
    },
    "precision": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Decimal precision"
    },
    "confidence_level": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence level (0-1)"
    },
    "lower_bound": {
      "type": ["number", "null"],
      "description": "Lower bound of confidence interval"
    },
    "upper_bound": {
      "type": ["number", "null"],
      "description": "Upper bound of confidence interval"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/EvidenceLocator"
      },
      "description": "Evidence supporting this claim"
    },
    "provenance": {
      "type": "object",
      "description": "Provenance metadata"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "EvidenceLocator": {
      "type": "object",
      "required": ["source_type", "uri", "content_hash"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["oa_document", "fixture", "computed", "external_api"]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "page": {
          "type": ["integer", "null"]
        },
        "section": {
          "type": ["string", "null"]
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
